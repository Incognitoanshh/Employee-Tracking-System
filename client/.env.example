# ─────────────────────────────────────────
# ETS Client — Environment Variables
# Copy this file to client/.env and fill in the values.
#
# For BUILDS this file is not used — GitHub Actions writes its own from
# repository secrets (.github/workflows/build.yml). This is for running
# from source during development.
# ─────────────────────────────────────────

APP_NAME=Amaze ETS

# Where the server is. Change this to https://your-domain/api once HTTPS
# is enabled — and rebuild, because it is compiled into the client.
API_BASE_URL=http://65.21.212.85:8000/api

# Fallbacks only. The real values come from the server on every sync, so
# these apply for the few seconds before the first one lands.
SCREENSHOT_MIN_INTERVAL=180
SCREENSHOT_MAX_INTERVAL=600
IDLE_THRESHOLD=60

# Screenshots are AES-256-GCM encrypted on the device before they are
# written or uploaded. This key decrypts them.
#
# IT MUST MATCH the key every other client and the admin panel use — the
# admin panel decrypts with it to display previews. Change it and every
# screenshot taken before the change becomes unreadable, forever.
# 64 hex characters:  openssl rand -hex 32
SCREENSHOT_ENCRYPTION_KEY=

# Optional: shrink captures before encrypting. Defaults shown.
# SCREENSHOT_MAX_WIDTH=1920
# SCREENSHOT_JPEG_QUALITY=75
