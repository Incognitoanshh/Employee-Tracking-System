# ─────────────────────────────────────────
# ETS Server — Environment Variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ets_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT signing secret. Use a long random string:
#     openssl rand -base64 48
# Changing it signs everybody out, which is the point if it ever leaks.
JWT_SECRET=change_this_to_a_long_random_string

# Server port. The deployment uses 8000 — this said 5000 for a long time
# while production ran on 8000, which sent people debugging the wrong port.
PORT=8000

# CORS — where the client connects from.
ALLOWED_ORIGIN=http://localhost:8000

# Optional: screenshot upload directory (default: server/uploads/screenshots)
# UPLOAD_DIR=/var/ets/screenshots

# Set to 1 ONLY when nginx is in front AND port 8000 is firewalled to
# localhost. Before that it would let a client spoof its own IP; after it,
# leaving it unset makes every request look like 127.0.0.1 and one shared
# rate-limit bucket locks out the whole office. enable_https.sh sets it.
TRUST_PROXY=

# ── Health alerts ────────────────────────────────────────────────────
# Where healthcheck.sh should push an alert so somebody actually sees it.
# Without this the alert only reaches ~/ets-health.log, which nobody opens
# until they have already noticed the outage.
#
# ntfy.sh is free and needs no account: pick a long random topic, install
# the ntfy app, subscribe to it. THE TOPIC IS THE SECRET — anyone who knows
# it can read your alerts, so keep it unguessable and out of documents.
# The alerts carry no credentials and no employee data.
# ETS_NTFY_TOPIC=ets-alerts-change-this-to-something-random

# ── Off-site backup — set by server/scripts/setup_offsite.sh ──────────
# The rclone remote to push backups to, with the colon.
# RCLONE_REMOTE=ets-offsite:ets-backups
#
# Encrypts the config archive before it leaves the machine. That archive
# contains this file, so without it losing the remote's credentials would
# hand over the database password and the encryption key too.
# KEEP A COPY SOMEWHERE THAT IS NOT THIS SERVER.
# CONFIG_PASSPHRASE=

# ── Email ──────────────────────────────────────────────────────────────
# Needed for the verification code on My Profile, and for alerts by email.
# Without these the server starts and everything else works; only the
# sending stops, and it says so rather than failing quietly.
#
# SMTP_PASS MUST BE AN APP PASSWORD, never the mailbox password. A mailbox
# password in a file is the whole mailbox — mail, contacts, and every account
# that can be reset through it. An app password does one thing and can be
# revoked on its own.
#
# NOTHING REAL GOES IN THIS FILE. It is committed; .env is not.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Amaze Connect <no-reply@yourcompany.com>
