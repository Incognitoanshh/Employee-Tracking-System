# Environment
.env
*.env.local

# Node
node_modules/
npm-debug.log

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/

# Storage (generated at runtime)
storage/
client/storage/

# Screenshots (uploaded files)
server/uploads/screenshots/*.png
server/uploads/screenshots/*.jpg
server/uploads/screenshots/*.jpeg
!server/uploads/screenshots/.gitkeep

# Keys
client/security/secret.key
storage/keys/

# macOS
.DS_Store
__MACOSX/

# PyInstaller
*.spec
dist/
build/

# DB dumps (except schema)
ets_db.sql

# Local .env backups (never commit)
client/.env.backup-*
# .save is what nano leaves behind — one was committed, holding a
# stale APP_NAME and API address that no longer matched anything.
*.env.save
server/.env.backup-*

# Uploaded screenshots — data, never source.
# These were untracked AND un-ignored, which meant a routine `git stash -u`
# or `git clean` on the server would have swept 136 MB of employee
# screenshots out of the working tree. Recoverable from a stash, but not
# something that should ever be one command away — least of all during a
# deploy, which is exactly when those commands get reached for.
server/uploads/screenshots/*
!server/uploads/screenshots/.gitkeep

# Local backups, if ETS_BACKUP_DIR is ever pointed inside the repo
ets-backups/

# Chat attachments. Encrypted by the client, so the server holds bytes it
# cannot read — but they are still employees' files and have no business in
# the repository. The directory itself is kept so a fresh deployment has
# somewhere to write before the first upload.
server/uploads/chat/*
!server/uploads/chat/.gitkeep

# Downloaded CI artifacts. `gh run download` drops these into the repo, and a
# 45 MB installer is not something to commit.
test-1-Windows-Installer/
test-1-Mac-DMG/
*.dmg
*Setup.exe

# Local repository backups. `git bundle` output is the whole history again —
# committing one doubles the repository every time.
*.bundle
